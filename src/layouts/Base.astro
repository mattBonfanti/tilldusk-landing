---
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/mulish/400.css';
import '@fontsource/mulish/600.css';
import app from '../app.mjs';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  {app.og && <meta property="og:image" content={new URL(app.og, Astro.site)} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <header class="top"><div class="wrap">
    <a class="brand" href="/"><i aria-hidden="true"></i>{app.name}</a>
    <a class="by" href="https://mattbonfanti.com/">by Matteo Bonfanti</a>
  </div></header>
  <slot />
  <footer class="foot"><div class="wrap">
    <span>{app.name} · {app.license}</span>
    <span><a href="/privacy/">Privacy</a> · <a href="/go/footer-source" rel="nofollow">Source</a> · <a href="https://mattbonfanti.com/">mattbonfanti.com</a></span>
  </div></footer>
</body>
</html>
<style is:global>
  :root { --ink:#000; --paper:#fff; --accent:#C4FF47; --primary:#0B51C2; --soft:#333; --mute:#5A5A5A; --line:#E4E6EC; --r:14px;
    --head:'Jost',ui-sans-serif,system-ui,sans-serif; --body:'Mulish',ui-sans-serif,system-ui,sans-serif; }
  *,*::before,*::after{box-sizing:border-box}
  body{margin:0;font:400 1.0625rem/1.7 var(--body);color:var(--soft);background:var(--paper)}
  h1,h2,h3{font-family:var(--head);color:var(--ink);font-weight:400;line-height:1.08;letter-spacing:-.02em;margin:0 0 1rem}
  h1{font-size:clamp(2.4rem,1.5rem + 4vw,4.6rem)} h2{font-size:clamp(1.7rem,1.3rem + 1.8vw,2.6rem)} h3{font-size:1.2rem;font-weight:500}
  p{margin:0 0 1rem;max-width:64ch} a{color:var(--primary);text-underline-offset:.2em}
  :focus-visible{outline:3px solid var(--primary);outline-offset:3px}
  .wrap{width:min(100% - 2.5rem,1080px);margin-inline:auto}
  .top{border-bottom:1px solid var(--line)} .top .wrap{display:flex;justify-content:space-between;align-items:center;min-height:64px;gap:1rem}
  .brand{display:inline-flex;align-items:center;gap:.55rem;font-family:var(--head);font-weight:500;color:var(--ink);text-decoration:none;min-height:44px}
  .brand i{width:12px;height:12px;border-radius:3px;background:var(--accent);border:1.5px solid var(--ink)}
  .by{color:var(--mute);text-decoration:none;min-height:44px;display:inline-flex;align-items:center}
  .on-dark{background:var(--ink);color:#C9C9C9} .on-dark h1,.on-dark h2{color:#fff}
  .btn{display:inline-flex;align-items:center;gap:.5rem;min-height:48px;padding:.8rem 1.5rem;border-radius:2rem;font-family:var(--head);font-weight:500;text-decoration:none;border:1px solid transparent}
  .btn-a{background:var(--accent);color:var(--ink)} .btn-a:hover{background:#fff}
  .btn-g{border-color:#3A3A3A;color:#fff} .btn-g:hover{border-color:#fff}
  .foot{border-top:1px solid var(--line);padding:2rem 0 3rem;font-size:.9rem;color:var(--mute)}
  .foot .wrap{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
  .foot a{min-height:44px;display:inline-flex;align-items:center}
</style>
